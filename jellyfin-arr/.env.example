# Set these to the UID/GID that should own files created by the containers.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Paths are relative to this folder by default. Both roots must be writable
# by PUID:PGID; Jellyfin mounts DATA_ROOT read-only.
CONFIG_ROOT=./config
DATA_ROOT=./data

# Web interfaces
JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
JELLYSEERR_PORT=5055
QBITTORRENT_PORT=8080

# qBittorrent peer connections (TCP and UDP)
TORRENT_PORT=6881
